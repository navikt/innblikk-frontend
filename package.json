{
  "name": "umami-start",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --report-unused-disable-directives",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "concurrently --names \"VITE,SERVER\" --prefix-colors \"cyan,green\" \"pnpm run dev\" \"pnpm run server\"",
    "prepare": "husky || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.5.0",
    "@google/genai": "2.31.0",
    "@navikt/aksel-icons": "^8.20.1",
    "@react-querybuilder/datetime": "8.25.0",
    "@toon-format/toon": "^4.4.0",
    "date-fns": "^4.4.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "fuse.js": "^7.5.0",
    "helmet": "^8.3.0",
    "node-sql-parser": "^5.4.0",
    "pino": "^10.4.0",
    "react-markdown": "^10.1.0",
    "react-querybuilder": "8.25.0",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.9.0"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@eslint/js": "^10.0.1",
    "@fluentui/react": "^8.125.9",
    "@fluentui/react-charting": "^5.25.13",
    "@monaco-editor/react": "^4.7.0",
    "@navikt/analytics-types": "0.0.13",
    "@navikt/ds-css": "^8.20.1",
    "@navikt/ds-react": "^8.20.1",
    "@navikt/ds-tailwind": "^8.20.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@uiw/react-codemirror": "^4.25.12",
    "@unhead/react": "^3.4.3",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/ui": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prismjs": "^1.30.0",
    "react": "^19.3.1",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "react-simple-code-editor": "^0.14.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "xlsx-js-style": "^1.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md}": "prettier --write",
    "*.{ts,tsx,js}": "eslint --fix --report-unused-disable-directives"
  }
}
