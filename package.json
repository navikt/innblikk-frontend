{
  "name": "umami-start",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --report-unused-disable-directives",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "concurrently --names \"VITE,SERVER\" --prefix-colors \"cyan,green\" \"pnpm run dev\" \"pnpm run server\"",
    "prepare": "husky || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "@google/genai": "2.16.0",
    "@navikt/aksel-icons": "^8.10.6",
    "@navikt/oasis": "4.1.1",
    "@react-querybuilder/datetime": "8.19.0",
    "@toon-format/toon": "^2.1.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "react-querybuilder": "8.19.0",
    "sql-formatter": "^15.7.0"
  },
  "devDependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@eslint/js": "^9.39.2",
    "@fluentui/react": "^8.125.4",
    "@fluentui/react-charting": "^5.25.6",
    "@monaco-editor/react": "^4.7.0",
    "@navikt/analytics-types": "0.0.9",
    "@navikt/ds-css": "^8.10.6",
    "@navikt/ds-react": "^8.10.6",
    "@navikt/ds-tailwind": "^8.10.6",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@uiw/react-codemirror": "^4.25.9",
    "@unhead/react": "^2.1.3",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "@vitest/ui": "^4.1.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.2",
    "lint-staged": "^16.4.0",
    "lucide-react": "^0.562.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "prismjs": "^1.30.0",
    "react": "^19.2.4",
    "react-code-blocks": "^0.1.6",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "react-simple-code-editor": "^0.14.1",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.54.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.4",
    "xlsx-js-style": "^1.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,json,css,md}": "prettier --write",
    "*.{ts,tsx,js}": "eslint --fix --report-unused-disable-directives"
  }
}
