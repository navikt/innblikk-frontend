SITEIMPROVE_BASE_URL=https://reops-proxy.intern.nav.no/siteimprove
MOCK_NAV_IDENT=Z123456

# part of the identity() hash, prevents cracking the navident (attacker would also need to guess this)
# rotating this secret rotates all keys
ANALYTICS_IDENTITY_PEPPER=secretpepper123

# Backend: pick one (default is the real dev backend, which needs BACKEND_TOKEN for dev data via reops-proxy)
# MOCK_BACKEND=true                       # in-memory mock, no token/network needed (port: MOCK_BACKEND_PORT, default 8087)
# BACKEND_TOKEN=THE_TEAM-SHARED_SECRET_BACKEND_TOKEN
# BACKEND_BASE_URL=http://localhost:8086  # local backend

# Real dev BigQuery/Gemini directly (needs gcloud auth):
# GOOGLE_APPLICATION_CREDENTIALS=/Users/YOU/.config/gcloud/application_default_credentials.json
